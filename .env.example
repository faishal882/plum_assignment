# PostgreSQL container and application connection
POSTGRES_DB=claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims
POSTGRES_PORT=55432
CLAIMS_DATABASE_URL=postgresql+psycopg://claims:claims@127.0.0.1:55432/claims
CLAIMS_TEST_DATABASE_URL=postgresql+psycopg://claims:claims@127.0.0.1:55432/claims_test
# Required only when deliberately running destructive tests against the application database.
CLAIMS_ALLOW_DESTRUCTIVE_TEST_DATABASE=0

# Local document storage and upload limits
CLAIMS_DATA_ROOT=data/documents
CLAIMS_MAX_DOCUMENTS=10
CLAIMS_MAX_FILE_BYTES=20971520
CLAIMS_MAX_CLAIM_BYTES=52428800
CLAIMS_MAX_DOCUMENT_PAGES=10
CLAIMS_UPLOAD_CHUNK_BYTES=1048576

# Local rendering and Amazon Textract
CLAIMS_MAX_TEXTRACT_PAGE_BYTES=5242880
CLAIMS_PAGE_RENDER_DPI=180
CLAIMS_AWS_REGION=ap-south-1
CLAIMS_TEXTRACT_TIMEOUT_SECONDS=30
CLAIMS_TEXTRACT_CONCURRENCY_LIMIT=2

# Amazon Bedrock
CLAIMS_BEDROCK_REGION=us-west-2
CLAIMS_BEDROCK_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
CLAIMS_BEDROCK_TIMEOUT_SECONDS=90
CLAIMS_BEDROCK_CONCURRENCY_LIMIT=2

# Provider attempts and durable workflow retry schedule
CLAIMS_PROVIDER_MAX_ATTEMPTS=3
CLAIMS_RETRY_BASE_SECONDS=2
CLAIMS_RETRY_MAX_SECONDS=60
CLAIMS_RETRY_JITTER_RATIO=0.25

# Local Phoenix tracing and rotating privacy-safe engineering logs
CLAIMS_OBSERVABILITY_ENABLED=0
CLAIMS_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
CLAIMS_PHOENIX_PROJECT=plum-claims-local
CLAIMS_LOG_ROOT=data/logs
CLAIMS_LOG_MAX_BYTES=5242880
CLAIMS_LOG_BACKUP_COUNT=5
CLAIMS_EXECUTION_PROFILE=RECORDED_LOCAL
CLAIMS_OBSERVABILITY_CAPTURE_CONTENT=0
CLAIMS_OBSERVABILITY_SYNTHETIC_ONLY=0

# Live AWS tests are disabled by default because they may incur charges.
CLAIMS_RUN_LIVE_AWS=0

# Local worker operation
CLAIMS_WORKER_ID=claims-worker-local
CLAIMS_WORKER_POLL_SECONDS=1
CLAIMS_WORKER_LEASE_SECONDS=300
CLAIMS_WORKER_SHUTDOWN_SECONDS=120

# Optional: select a named AWS CLI profile. Never place access keys in this file.
# AWS_PROFILE=your-profile-name
